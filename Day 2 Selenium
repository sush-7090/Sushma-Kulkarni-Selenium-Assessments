package Popups;

import java.io.File;
import java.io.IOException;
import java.time.Duration;
import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.OutputType;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.edge.EdgeDriver;
import org.openqa.selenium.io.FileHandler;

public class Assessment5 {

	public static void main(String[] args) throws InterruptedException, IOException {
		WebDriver driver = new EdgeDriver();

        driver.manage().window().maximize();

        driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(20));
        driver.get("https://demowebshop.tricentis.com/");
        Thread.sleep(2000);
        WebElement ele = driver.findElement(By.xpath("(//input[@value='Add to cart'])[2]"));
        ele.getSize();
        ele.click();
        driver.findElement(By.xpath("//span[text()='Shopping cart']")).click();
        Thread.sleep(2000);
        WebElement ele1 = driver.findElement(By.xpath("//input[@name='removefromcart']"));
        System.out.println(ele1.isSelected());
        System.out.println(ele1.getRect());
        System.out.println(ele1.getRect().getX());
        System.out.println(ele1.getRect().getY());
        
        List<WebElement> msg = driver.findElements(By.xpath("//div[contains(@class,'message-error')]"));

           if(msg.size() > 0)
        	{
        	    System.out.println("Alert is displayed before clicking");
        	}
        	else
        	{
        	    System.out.println("Alert is not displayed before clicking");
        	}
        
        
        
        driver.findElement(By.xpath("//input[@name='applydiscountcouponcode']")).click();
        WebElement alert = driver.findElement(By.xpath("//div[@class='message']"));
        if(alert.isDisplayed())
        {
            System.out.println("Alert is displayed after clicking");
        }
        else
        {
            System.out.println("Alert is not displayed after clicking");
        }
        
        WebElement ele3 = driver.findElement(By.xpath("//td[@class='product-picture']"));
        File src = ele3.getScreenshotAs(OutputType.FILE);
		File dest=new File("./ss/demoshop.png");
		FileHandler.copy(src, dest);
        
        

	}

}
