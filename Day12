public class OrgAssesInfo12 extends BaseclassOrg  {
	
	 @Test
	    public void editEmployeeTest() throws Exception {

	        // Read Excel
		 FileInputStream fi = new FileInputStream("./src/test/resources/DDT/org.xlsx");

			Workbook wb = WorkbookFactory.create(fi);

			String firstName =wb.getSheetAt(1).getRow(1).getCell(0).getStringCellValue();

			String lastName =wb.getSheetAt(1).getRow(1).getCell(1).getStringCellValue();

			String employeeId =wb.getSheetAt(1).getRow(1).getCell(2).getStringCellValue();

			System.out.println("First Name = " + firstName);
			System.out.println("Last Name = " + lastName);
			System.out.println("Employee ID = " + employeeId);

			fi.close();
			wb.close();

	        // My Info
	        Myinfoclass myInfo = new Myinfoclass(driver);

	        myInfo.clickMyInfo();


	        // Edit employee details
	        myInfo.editFirstName(firstName);

	        myInfo.editLastName(lastName);

	        myInfo.editEmployeeId(employeeId);


	        // Save
	        myInfo.clickSave();

	 }
	 @Test
	 public void verifyclass() throws InterruptedException {
		 
	        Myinfoclass mp = new Myinfoclass(driver);

	        mp.clickMyInfo();
	        
	        Thread.sleep(5000);
	        
			// VERIFY UPDATED DETAILS
