package UsingTestNG;

import org.testng.annotations.Test;

import BaseclassUtility.SauceBaseClass;
import PomUtilites.ExcelUtility;
import SaucePomAsses.CartPageSauce;
import SaucePomAsses.CheckoutOverviewPage;
import SaucePomAsses.CheckoutPageSauce;
import SaucePomAsses.LoginPageSauce;
import SaucePomAsses.ProductPageSauce;

public class SauceDemoTest extends SauceBaseClass {

	    @Test
	    public void loginTest() throws InterruptedException {

	        LoginPageSauce loginPage = new LoginPageSauce(driver);

	        String username = p.getProperty("username");
	        String password = p.getProperty("password");

	        loginPage.login(username, password);

	        ProductPageSauce productsPage = new ProductPageSauce(driver);

	        String actualTitle = productsPage.getProductsTitle();

	        if (actualTitle.equals("Products")) {
	            System.out.println("PASS: Products page is displayed");
	        } else {
	            System.out.println("FAIL: Products page is not displayed");
	        }
	    }


	    @Test(dependsOnMethods = "loginTest")
	    public void orderPlacementTest() throws Exception {

	        ProductPageSauce productsPage = new ProductPageSauce(driver);

	        // Add Backpack
	        productsPage.addBackpackToCart();

	        // Verify cart contains 1 item
	        String cartCount = productsPage.getCartCount();

	        if (cartCount.equals("1")) {
	            System.out.println("PASS: Cart contains 1 item");
	        } else {
	            System.out.println("FAIL: Cart does not contain 1 item");
	        }


	        // Open cart
	        productsPage.clickCart();

	        CartPageSauce cartPage = new CartPageSauce(driver);

	        // Verify Backpack
	        String productName = cartPage.getBackpackName();

	        if (productName.equals("Sauce Labs Backpack")) {
	            System.out.println("PASS: Sauce Labs Backpack is displayed");
	        } else {
	            System.out.println("FAIL: Sauce Labs Backpack is not displayed");
	        }


	        // Click Checkout
	        cartPage.clickCheckout();

	        CheckoutPageSauce checkoutPage = new CheckoutPageSauce(driver);

	        // Get data from Excel
	        String firstName =ExcelUtility.getExcelData("Sheet1", 1, 0);

	        String lastName =ExcelUtility.getExcelData("Sheet1", 1, 1);

	        String postalCode =ExcelUtility.getExcelData("Sheet1", 1, 2);

	        // Enter details
	        checkoutPage.enterDetails(firstName,lastName, postalCode);


	        // Verify Checkout Overview
	        String overviewTitle =
	                checkoutPage.getPageTitle();

	        if (overviewTitle.equals("Checkout: Overview")) {
	            System.out.println(
	                    "PASS: Checkout: Overview page is displayed");
	        } else {
	            System.out.println(
	                    "FAIL: Checkout: Overview page is not displayed");
	        }


	        // Finish
	        CheckoutOverviewPage overviewPage =new CheckoutOverviewPage(driver);

	        overviewPage.clickFinish();


	        // Verify success message
	        String message = overviewPage.getSuccessMessage();

	        if (message.equals("Thank you for your order!")) {
	            System.out.println(
	                    "PASS: Thank you for your order! is displayed");
	        } else {
	            System.out.println(
	                    "FAIL: Thank you for your order! is not displayed");
	        }
	    }
	}


